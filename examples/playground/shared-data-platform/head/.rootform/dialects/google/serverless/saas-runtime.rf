concept "saas-runtime-service" {
  kind        = scope
  description = "A SaaS Runtime service managing tenant units and rollouts."
}

concept "saas-runtime-tenant" {
  kind        = entity
  description = "A tenant managed through SaaS Runtime."
}

rule "saas-runtime-service" {
  match {
    type = "google_saas_runtime_saas"
  }

  as = concept.saas-runtime-service
}

rule "saas-runtime-tenant" {
  match {
    type = "google_saas_runtime_tenant"
  }

  as = concept.saas-runtime-tenant
}
