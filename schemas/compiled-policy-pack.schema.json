  "$id": "https://rootform.dev/schemas/compiled-policy-pack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Evaluation-ready Policy Pack with exact owner-kind semantic pins. Schema validation checks structure, not digest integrity or semantic linking. Decoder additionally verifies content_digest and linked_digest, pin/target consistency, policy identity, unique IDs, canonical collection order, UTF-8 and duplicate JSON keys. String limits here count Unicode characters; decoder enforces UTF-8 byte limits (4096 per string, 1024 per message, 4 MiB total). It also enforces 16 MiB serialized size, expression depth 64, 1024 expression nodes per Policy and 65536 per pack, JSON depth 80 and 2097152 JSON values. JSON Schema integers are mathematical values; wire decoder requires int64 integer tokens, and positions must fit host int. Definition ranges remain available for explanations and are excluded from both digests.",
  "properties": {
    "content_digest": {
      "$ref": "#/$defs/digest",
      "description": "Canonical portable Policy Pack source digest: language contract, metadata, targets, and assertions; definition ranges excluded."
    },
    "format_version": {
      "const": "v1"
    },
    "language_version": {
      "const": "0.1.0"
    },
    "linked_digest": {
      "$ref": "#/$defs/digest",
      "description": "Canonical linked artifact digest, including content_digest and exact semantic pins; linked_digest itself and all definition ranges excluded."
    },
    "pins": {
      "items": {
        "$ref": "#/$defs/semantic_pin"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/policy"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "policy_pack": {
      "$ref": "#/$defs/policy_pack"
    }
  },
