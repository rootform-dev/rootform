{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootform.dev/schemas/presentation-manifest.schema.json",
  "title": "Rootform Dialect presentation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version"],
  "properties": {
    "format_version": { "const": "1" },
    "resources": { "$ref": "#/$defs/resourceIdentities" },
    "rules": { "$ref": "#/$defs/localIdentities" },
    "concepts": { "$ref": "#/$defs/localIdentities" },
    "resource_labels": { "$ref": "#/$defs/resourceLabels" },
    "rule_labels": { "$ref": "#/$defs/localLabels" },
    "concept_labels": { "$ref": "#/$defs/localLabels" }
  },
  "$defs": {
    "visualIdentity": {
      "type": "string",
      "maxLength": 129,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "localName": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "resourceName": {
      "maxLength": 129,
      "pattern": "^(?:resource|data|ephemeral|action)/[a-z][a-z0-9_-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "localIdentities": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/localName" },
      "additionalProperties": { "$ref": "#/$defs/visualIdentity" }
    },
    "resourceIdentities": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/resourceName" },
      "additionalProperties": { "$ref": "#/$defs/visualIdentity" }
    },
    "localLabels": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/localName" },
      "additionalProperties": { "$ref": "#/$defs/label" }
    },
    "resourceLabels": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/resourceName" },
      "additionalProperties": { "$ref": "#/$defs/label" }
    }
  }
}
