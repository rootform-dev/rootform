# Generated by scripts/generate-azure-dialect.ts.
concept "dedicated-host" {
  kind        = entity
  description = "A physical Azure server dedicated to one customer."
}

concept "dedicated-host-group" {
  kind        = scope
  description = "An Azure Dedicated Host placement group."
}

rule "availability-set" {
