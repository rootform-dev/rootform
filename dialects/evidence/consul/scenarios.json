{
  "format_version": "1",
  "scenarios": [
    {
      "id": "consul-minimal",
      "fixture": "fixtures/consul-v2/minimal",
      "limitations": [
        "synthetic Terraform proves partition, namespace, catalog node, service, and mesh root without contacting Consul"
      ],
      "minimum": {
        "representations": 5,
        "relations": 0,
        "contexts": 3,
        "contributions": 0
      },
      "maximum_facts": {
        "contexts": 3,
        "contributions": 0,
        "relations": 0
      },
      "required_rules": [
        "consul.rule.admin-partition",
        "consul.rule.config-entry-mesh-json",
        "consul.rule.namespace",
        "consul.rule.node",
        "consul.rule.service"
      ],
      "required_facts": [
        {
          "collection": "contexts",
          "from": "representation:1:root:resource:consul_namespace.applications",
          "to": "representation:1:root:resource:consul_admin_partition.platform",
          "dimension": "consul.context.ownership",
          "rule": "consul.rule.namespace"
        },
        {
          "collection": "contexts",
          "from": "representation:1:root:resource:consul_service.api",
          "to": "representation:1:root:resource:consul_node.api",
          "dimension": "rf.context.runtime",
          "rule": "consul.rule.service"
        },
        {
          "collection": "contexts",
          "from": "representation:1:root:resource:consul_service.api",
          "to": "representation:1:root:resource:consul_namespace.applications",
          "dimension": "consul.context.ownership",
          "rule": "consul.rule.service"
        }
      ],
      "expected_html_labels": [
        "Consul admin partition",
        "Consul namespace",
        "Consul service",
        "Consul service mesh"
      ]
    },
    {
      "id": "consul-service-networking",
      "fixture": "fixtures/consul-v2/scenarios",
      "limitations": [
        "synthetic references prove service catalog, tenancy, mesh, gateways, traffic management, peering, exports, and identity without provider APIs; nested repeated-block targets stay unclaimed"
      ],
      "minimum": {
        "representations": 49,
        "relations": 0,
        "contexts": 9,
        "contributions": 16
      },
      "maximum_facts": {
        "contexts": 9,
        "contributions": 16,
        "relations": 0
      },
      "required_rules": [
