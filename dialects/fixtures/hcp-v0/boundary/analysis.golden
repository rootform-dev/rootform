    "concepts": [
      {
        "id": "aws.concept.iam-role",
        "owner": "aws",
        "name": "iam-role",
        "description": "An AWS IAM role, distinct from an explicitly non-human service principal."
      },
      {
        "id": "hcp.concept.boundary-cluster",
        "owner": "hcp",
        "name": "boundary-cluster",
        "description": "A HashiCorp-managed Boundary control plane on HCP."
      },
      {
        "id": "hcp.concept.managed-secret",
        "owner": "hcp",
        "name": "managed-secret",
        "description": "A managed secret identity whose sensitive value stays outside architecture output."
      },
      {
        "id": "hcp.concept.network-peering",
        "owner": "hcp",
        "name": "network-peering",
        "description": "A direct private connectivity agreement between virtual networks."
      },
      {
        "id": "hcp.concept.notification-webhook",
        "owner": "hcp",
        "name": "notification-webhook",
        "description": "A webhook receiving HCP project resource lifecycle events."
      },
      {
        "id": "hcp.concept.project",
        "owner": "hcp",
        "name": "project",
        "description": "An HCP boundary grouping managed products and access."
      },
      {
        "id": "hcp.concept.vault-radar-source",
        "owner": "hcp",
        "name": "vault-radar-source",
        "description": "A source repository scanned by HCP Vault Radar for secret exposure."
      },
      {
        "id": "hcp.concept.vault-secrets-application",
        "owner": "hcp",
        "name": "vault-secrets-application",
        "description": "An HCP Vault Secrets application boundary grouping secrets and sync destinations."
      },
      {
        "id": "hcp.concept.waypoint-configuration",
        "owner": "hcp",
        "name": "waypoint-configuration",
        "description": "An action or HCP Terraform connection supporting HCP Waypoint."
      },
      {
        "id": "hcp.concept.workload-identity-provider",
        "owner": "hcp",
        "name": "workload-identity-provider",
        "description": "An HCP federation boundary exchanging an external workload identity for a service principal."
      },
      {
        "id": "rf.concept.service-identity",
        "owner": "rf",
        "name": "service-identity",
        "description": "A principal explicitly intended for a non-human service or workload, excluding generic roles, permissions, bindings, and credentials."
      },
      {
        "id": "rf.concept.virtual-network",
        "owner": "rf",
        "name": "virtual-network",
        "description": "An explicitly declared virtual network."
      }
    ],
