}

rule "proximity-placement-group" {
  match {
    type = "azurerm_proximity_placement_group"
  }

  as = concept.compute-placement
}

rule "virtual-machine-restore-point" {
  match {
    type = "azurerm_virtual_machine_restore_point"
  }

