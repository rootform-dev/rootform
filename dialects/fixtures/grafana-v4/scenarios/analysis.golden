    "concepts": [
      {
        "id": "aws.concept.iam-role",
        "owner": "aws",
        "name": "iam-role",
        "description": "An AWS IAM role, distinct from an explicitly non-human service principal."
      },
      {
        "id": "grafana.concept.agent-observability-configuration",
        "owner": "grafana",
        "name": "agent-observability-configuration",
        "description": "A collection, evaluator, evaluation, guard, or action configuration for Agent Observability."
      },
      {
        "id": "grafana.concept.browser-observability-application",
        "owner": "grafana",
        "name": "browser-observability-application",
        "description": "An application boundary instrumented for browser or frontend observability."
      },
      {
        "id": "grafana.concept.cloud-integration-configuration",
        "owner": "grafana",
        "name": "cloud-integration-configuration",
        "description": "A scrape job, integration package, or plugin supporting a Grafana Cloud integration."
      },
      {
        "id": "grafana.concept.cloud-observability-integration",
        "owner": "grafana",
        "name": "cloud-observability-integration",
        "description": "A provider-neutral integration collecting telemetry and resource data from a cloud account, subscription, or project."
      },
      {
        "id": "grafana.concept.data-source",
        "owner": "grafana",
        "name": "data-source",
        "description": "A Grafana connection to an external or hosted telemetry data source."
      },
      {
        "id": "grafana.concept.git-sync-connection",
        "owner": "grafana",
        "name": "git-sync-connection",
        "description": "A reusable authorization connection between Grafana Git Sync and a Git provider."
      },
      {
        "id": "grafana.concept.git-sync-repository",
        "owner": "grafana",
        "name": "git-sync-repository",
        "description": "A repository boundary synchronized bidirectionally with a Grafana instance."
      },
      {
        "id": "grafana.concept.identity-configuration",
        "owner": "grafana",
        "name": "identity-configuration",
        "description": "An SSO or SCIM configuration supporting access to Grafana."
      },
      {
        "id": "grafana.concept.knowledge-graph",
        "owner": "grafana",
        "name": "knowledge-graph",
        "description": "A Grafana Cloud Knowledge Graph instance mapping observed services and dependencies."
      },
      {
        "id": "grafana.concept.knowledge-graph-configuration",
        "owner": "grafana",
        "name": "knowledge-graph-configuration",
        "description": "A dataset, mapping, threshold, rule, or notification detail for Knowledge Graph."
      },
      {
        "id": "grafana.concept.machine-learning-configuration",
        "owner": "grafana",
        "name": "machine-learning-configuration",
        "description": "A machine-learning job, outlier detector, or alert supporting observability operations."
      },
      {
        "id": "grafana.concept.metrics-scrape-job",
        "owner": "grafana",
        "name": "metrics-scrape-job",
        "description": "A Grafana Cloud scrape job collecting metrics from an explicit endpoint."
      },
      {
        "id": "grafana.concept.observability-tenant",
        "owner": "grafana",
        "name": "observability-tenant",
        "description": "A provider-neutral account, organization, or stack boundary isolating observability data and configuration."
      },
      {
        "id": "grafana.concept.oncall-integration",
        "owner": "grafana",
        "name": "oncall-integration",
        "description": "An inbound Grafana OnCall integration receiving alerts from an external system."
      },
      {
        "id": "grafana.concept.oncall-routing",
        "owner": "grafana",
        "name": "oncall-routing",
        "description": "A route supporting an OnCall integration without becoming an application flow."
      },
      {
        "id": "grafana.concept.performance-test",
        "owner": "grafana",
        "name": "performance-test",
        "description": "A k6 test definition supporting a performance-testing project."
      },
      {
        "id": "grafana.concept.performance-testing-project",
        "owner": "grafana",
        "name": "performance-testing-project",
        "description": "A Grafana Cloud k6 project grouping performance and load tests."
      },
      {
        "id": "grafana.concept.platform-installation",
        "owner": "grafana",
        "name": "platform-installation",
        "description": "A product activation or installation supporting a Grafana Cloud stack."
      },
      {
        "id": "grafana.concept.private-data-source-connect-network",
        "owner": "grafana",
        "name": "private-data-source-connect-network",
        "description": "A Grafana Cloud PDC network connecting a stack to data sources hosted on a private network."
      },
      {
        "id": "grafana.concept.synthetic-check",
        "owner": "grafana",
        "name": "synthetic-check",
        "description": "A synthetic check supporting an observed target without owning target runtime."
      },
      {
        "id": "grafana.concept.synthetic-execution-location",
        "owner": "grafana",
        "name": "synthetic-execution-location",
        "description": "A public or private execution location running synthetic checks."
      },
      {
        "id": "grafana.concept.telemetry-collector",
        "owner": "grafana",
        "name": "telemetry-collector",
        "description": "A Grafana Alloy or OpenTelemetry Collector managed through Grafana Fleet Management."
      },
      {
        "id": "rf.concept.service-identity",
        "owner": "rf",
        "name": "service-identity",
        "description": "A principal explicitly intended for a non-human service or workload, excluding generic roles, permissions, bindings, and credentials."
      }
