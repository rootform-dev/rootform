        "name": "connection-configuration",
        "description": "Client enablement, SCIM, keys, or synchronization supporting an Auth0 Connection."
      },
      {
        "id": "auth0.concept.customer-organization",
        "owner": "auth0",
        "name": "customer-organization",
        "description": "An Auth0 Organization representing a customer or business audience inside a tenant."
      },
      {
        "id": "auth0.concept.directory-sync",
        "owner": "auth0",
        "name": "directory-sync",
        "description": "An Auth0 Directory Sync integration attached to an enterprise Connection."
      },
      {
        "id": "auth0.concept.domain-configuration",
        "owner": "auth0",
        "name": "domain-configuration",
        "description": "Default-domain or verification configuration supporting an Auth0 custom domain."
      },
      {
        "id": "auth0.concept.extension-configuration",
        "owner": "auth0",
        "name": "extension-configuration",
        "description": "A module or trigger binding supporting Auth0 identity extensions."
      },
      {
        "id": "auth0.concept.flow-vault-connection",
        "owner": "auth0",
        "name": "flow-vault-connection",
        "description": "A Forms and Flows Vault connection to an external integration."
      },
      {
        "id": "auth0.concept.identity-application",
        "owner": "auth0",
        "name": "identity-application",
        "description": "An application or relying-party client registered with an identity platform."
      },
      {
        "id": "auth0.concept.identity-connection",
        "owner": "auth0",
        "name": "identity-connection",
        "description": "An Auth0 Connection sourcing identities from an enterprise provider, social provider, database, or passwordless method."
      },
      {
        "id": "auth0.concept.identity-domain",
        "owner": "auth0",
        "name": "identity-domain",
        "description": "A custom domain exposing an Auth0-hosted identity endpoint."
      },
      {
        "id": "auth0.concept.identity-event-stream",
        "owner": "auth0",
        "name": "identity-event-stream",
        "description": "An Auth0 Event Stream publishing tenant events to an external destination or Action."
      },
      {
        "id": "auth0.concept.identity-extension",
        "owner": "auth0",
        "name": "identity-extension",
        "description": "An Auth0 Action, Rule, or Hook executing custom identity logic."
      },
      {
        "id": "auth0.concept.identity-tenant",
        "owner": "auth0",
        "name": "identity-tenant",
        "description": "An existing Auth0 tenant acting as an identity and authorization boundary."
      },
      {
        "id": "auth0.concept.identity-workflow",
        "owner": "auth0",
        "name": "identity-workflow",
        "description": "An Auth0 Form or Flow orchestrating an identity journey."
      },
      {
        "id": "auth0.concept.notification-provider",
        "owner": "auth0",
        "name": "notification-provider",
        "description": "An email or phone provider delivering Auth0 identity notifications."
      },
      {
        "id": "auth0.concept.self-service-configuration",
        "owner": "auth0",
        "name": "self-service-configuration",
        "description": "A connection or user-attribute profile supporting Self-Service SSO."
      },
      {
        "id": "auth0.concept.self-service-sso-profile",
        "owner": "auth0",
        "name": "self-service-sso-profile",
