# Generated by scripts/generate-azure-dialect.ts.
concept "machine-learning-compute" {
  kind        = entity
  description = "Compute capacity attached to Azure Machine Learning."
}

rule "machine-learning-compute-cluster" {
  match {
    kind = "resource"
    type = "azurerm_machine_learning_compute_cluster"
  }

  as = concept.machine-learning-compute
}

rule "machine-learning-compute-instance" {
  match {
    kind = "resource"
    type = "azurerm_machine_learning_compute_instance"
  }

  as = concept.machine-learning-compute
}

rule "machine-learning-inference-cluster" {
  match {
    kind = "resource"
    type = "azurerm_machine_learning_inference_cluster"
  }

  as = concept.core.ai-inference-endpoint
}
