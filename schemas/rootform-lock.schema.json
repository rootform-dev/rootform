{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootform.dev/schemas/rootform-lock.schema.json",
  "title": "Rootform dialect lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "entries"],
  "properties": {
    "format_version": { "const": "1" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "digest", "presentation_digest"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "presentation_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
