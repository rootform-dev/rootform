        "consul.rule.config-entry-api-gateway-json",
        "consul.rule.config-entry-ingress-gateway-json",
        "consul.rule.config-entry-mesh-json",
        "consul.rule.config-entry-service-intentions",
        "consul.rule.config-entry-service-resolver",
        "consul.rule.config-entry-service-router",
        "consul.rule.config-entry-service-splitter",
        "consul.rule.config-entry-terminating-gateway-json",
        "consul.rule.config-entry-v2-exported-services",
        "consul.rule.intention",
        "consul.rule.peering",
        "consul.rule.service"
