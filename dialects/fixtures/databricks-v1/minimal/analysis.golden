    "concepts": [
      {
        "id": "databricks.concept.ai-inference-endpoint",
        "owner": "databricks",
        "name": "ai-inference-endpoint",
        "description": "A managed endpoint that serves model inference requests."
      },
      {
        "id": "databricks.concept.compute-cluster",
        "owner": "databricks",
        "name": "compute-cluster",
        "description": "A Databricks compute cluster running data, analytics, or machine-learning workloads."
      },
      {
        "id": "databricks.concept.delta-share",
        "owner": "databricks",
        "name": "delta-share",
        "description": "A governed collection of data assets shared through Delta Sharing."
      },
      {
        "id": "databricks.concept.delta-sharing-provider",
        "owner": "databricks",
        "name": "delta-sharing-provider",
        "description": "An external organization providing data through Delta Sharing."
      },
      {
        "id": "databricks.concept.instance-pool",
        "owner": "databricks",
        "name": "instance-pool",
        "description": "A shared pool of cloud instances used to reduce Databricks cluster start time."
      },
      {
        "id": "databricks.concept.lakeflow-pipeline",
        "owner": "databricks",
        "name": "lakeflow-pipeline",
        "description": "A Lakeflow pipeline running declarative batch or streaming data processing."
      },
      {
        "id": "databricks.concept.lakehouse-federation-connection",
        "owner": "databricks",
        "name": "lakehouse-federation-connection",
        "description": "A Unity Catalog connection to an external data system for Lakehouse Federation."
      },
      {
        "id": "databricks.concept.unity-catalog-catalog",
        "owner": "databricks",
        "name": "unity-catalog-catalog",
        "description": "A Unity Catalog catalog organizing governed data and AI assets."
      },
      {
        "id": "databricks.concept.unity-catalog-metastore",
        "owner": "databricks",
        "name": "unity-catalog-metastore",
        "description": "A regional Unity Catalog metastore governing Databricks data and AI assets."
      },
      {
        "id": "databricks.concept.unity-catalog-schema",
        "owner": "databricks",
        "name": "unity-catalog-schema",
        "description": "A Unity Catalog schema organizing tables, volumes, models, and functions within a catalog."
      },
      {
        "id": "databricks.concept.workflow",
        "owner": "databricks",
        "name": "workflow",
        "description": "A managed workflow coordinating steps and service calls."
      },
      {
        "id": "rf.concept.object-storage-container",
        "owner": "rf",
        "name": "object-storage-container",
        "description": "An object storage container, excluding multi-service storage accounts."
      },
      {
        "id": "rf.concept.service-identity",
        "owner": "rf",
        "name": "service-identity",
        "description": "A principal explicitly intended for a non-human service or workload, excluding generic roles, permissions, bindings, and credentials."
      }
