    "concepts": [
      {
        "id": "auth0.concept.api-resource-server",
        "owner": "auth0",
        "name": "api-resource-server",
        "description": "An API registered as an Auth0 resource server for authorized applications."
      },
      {
        "id": "auth0.concept.application-configuration",
        "owner": "auth0",
        "name": "application-configuration",
        "description": "Credentials, grants, or associations supporting an Auth0 Application."
      },
      {
        "id": "auth0.concept.authentication-boundary",
        "owner": "auth0",
        "name": "authentication-boundary",
        "description": "An Auth0 Network ACL bounding authentication or management traffic."
      },
      {
        "id": "auth0.concept.authentication-configuration",
        "owner": "auth0",
        "name": "authentication-configuration",
