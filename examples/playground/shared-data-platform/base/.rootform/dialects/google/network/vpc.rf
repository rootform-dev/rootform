rule "vpc-network" {
  match {
    type = "google_compute_network"
  }

  as = concept.core.virtual-network
}

rule "vpc-subnetwork" {
  match {
    type = "google_compute_subnetwork"
  }

  as = concept.core.subnet

  context {
    as  = context.core.network
    to  = concept.core.virtual-network
    via = source.network
  }
}
