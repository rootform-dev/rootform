    "concepts": [
      {
        "id": "okta.concept.application-configuration",
        "owner": "okta",
        "name": "application-configuration",
        "description": "Claims, features, redirects, scopes, or access policy supporting an app integration."
      },
      {
        "id": "okta.concept.authentication-configuration",
        "owner": "okta",
        "name": "authentication-configuration",
        "description": "Authenticator, CAPTCHA, behavior, trusted-origin, or threat configuration supporting authentication."
      },
      {
        "id": "okta.concept.authorization-server",
        "owner": "okta",
        "name": "authorization-server",
        "description": "An Okta custom Authorization Server that mints OAuth and OIDC tokens."
      },
      {
        "id": "okta.concept.authorization-server-configuration",
        "owner": "okta",
        "name": "authorization-server-configuration",
        "description": "A claim, scope, policy, rule, or trusted-server association supporting an Authorization Server."
      },
      {
        "id": "okta.concept.domain-configuration",
        "owner": "okta",
        "name": "domain-configuration",
        "description": "Certificate or verification configuration supporting an Okta custom domain."
      },
      {
        "id": "okta.concept.external-identity-provider",
        "owner": "okta",
        "name": "external-identity-provider",
        "description": "An external OIDC, SAML, or social Identity Provider trusted by Okta."
      },
      {
        "id": "okta.concept.hook-configuration",
        "owner": "okta",
        "name": "hook-configuration",
        "description": "Verification or key configuration supporting an Okta hook."
      },
      {
        "id": "okta.concept.identity-application",
        "owner": "okta",
        "name": "identity-application",
        "description": "An application or relying-party client registered with an identity platform."
      },
      {
        "id": "okta.concept.identity-domain",
        "owner": "okta",
        "name": "identity-domain",
        "description": "A custom domain exposing an Okta-hosted identity endpoint."
      },
      {
        "id": "okta.concept.identity-event-extension",
        "owner": "okta",
        "name": "identity-event-extension",
        "description": "An Okta event or inline hook integrating an external callback into an identity lifecycle."
      },
      {
        "id": "okta.concept.identity-log-stream",
        "owner": "okta",
        "name": "identity-log-stream",
        "description": "An Okta System Log stream delivering security events to an external destination."
      },
      {
        "id": "okta.concept.identity-realm",
        "owner": "okta",
        "name": "identity-realm",
        "description": "An Okta Realm partitioning users within an organization."
      },
      {
        "id": "okta.concept.identity-tenant",
        "owner": "okta",
        "name": "identity-tenant",
        "description": "An Okta organization acting as an identity tenant boundary."
      },
      {
        "id": "okta.concept.network-zone",
        "owner": "okta",
        "name": "network-zone",
        "description": "A network location boundary used by Okta authentication and access decisions."
      },
      {
        "id": "okta.concept.provisioning-connection",
        "owner": "okta",
        "name": "provisioning-connection",
        "description": "An Okta application provisioning connection to an external system."
      },
      {
        "id": "okta.concept.security-events-provider",
        "owner": "okta",
        "name": "security-events-provider",
        "description": "A Security Events Provider supplying shared security signals to Okta."
      }
    ],
