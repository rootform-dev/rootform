        "id": "mongodb-atlas.concept.atlas-network-container",
        "owner": "mongodb-atlas",
        "name": "atlas-network-container",
        "description": "An Atlas address-space container used to configure peering, not a customer virtual network."
      },
      {
        "id": "mongodb-atlas.concept.cloud-provider-authorization",
        "owner": "mongodb-atlas",
        "name": "cloud-provider-authorization",
        "description": "An authorized customer cloud identity that MongoDB Atlas can assume or use."
      },
      {
        "id": "mongodb-atlas.concept.customer-key-management",
        "owner": "mongodb-atlas",
        "name": "customer-key-management",
        "description": "MongoDB Atlas project-level encryption at rest using customer-managed cloud keys."
      },
      {
        "id": "mongodb-atlas.concept.network-peering",
        "owner": "mongodb-atlas",
        "name": "network-peering",
        "description": "A direct private connectivity agreement between virtual networks."
      },
      {
        "id": "mongodb-atlas.concept.organization",
        "owner": "mongodb-atlas",
        "name": "organization",
        "description": "A MongoDB Atlas organization owning projects, access, and billing boundaries."
      },
      {
        "id": "mongodb-atlas.concept.private-endpoint",
        "owner": "mongodb-atlas",
        "name": "private-endpoint",
        "description": "A private endpoint exposing a service inside a virtual network."
      },
      {
        "id": "mongodb-atlas.concept.private-endpoint-registration",
        "owner": "mongodb-atlas",
        "name": "private-endpoint-registration",
        "description": "A registration joining an Atlas private endpoint service to a customer cloud private endpoint."
      },
      {
        "id": "mongodb-atlas.concept.private-endpoint-service",
        "owner": "mongodb-atlas",
        "name": "private-endpoint-service",
        "description": "A MongoDB Atlas regional private endpoint service exposed to a customer cloud network."
      },
      {
        "id": "mongodb-atlas.concept.project",
        "owner": "mongodb-atlas",
        "name": "project",
        "description": "A MongoDB Atlas project isolating database deployments, networking, access, and service configuration."
      },
