    "concepts": [
      {
        "id": "mongodb-atlas.concept.backup-export-destination",
        "owner": "mongodb-atlas",
        "name": "backup-export-destination",
        "description": "A MongoDB Atlas cloud backup export destination backed by customer object storage."
      },
      {
        "id": "mongodb-atlas.concept.backup-plan",
        "owner": "mongodb-atlas",
        "name": "backup-plan",
        "description": "A managed policy scheduling and retaining backups."
      },
      {
        "id": "mongodb-atlas.concept.cloud-provider-authorization",
        "owner": "mongodb-atlas",
        "name": "cloud-provider-authorization",
        "description": "An authorized customer cloud identity that MongoDB Atlas can assume or use."
      },
      {
        "id": "mongodb-atlas.concept.online-archive",
        "owner": "mongodb-atlas",
        "name": "online-archive",
        "description": "An Atlas Online Archive tiering infrequently accessed data from a database deployment."
      },
      {
        "id": "mongodb-atlas.concept.organization",
        "owner": "mongodb-atlas",
        "name": "organization",
        "description": "A MongoDB Atlas organization owning projects, access, and billing boundaries."
      },
      {
        "id": "mongodb-atlas.concept.project",
        "owner": "mongodb-atlas",
        "name": "project",
        "description": "A MongoDB Atlas project isolating database deployments, networking, access, and service configuration."
      },
      {
        "id": "mongodb-atlas.concept.search-deployment",
        "owner": "mongodb-atlas",
        "name": "search-deployment",
        "description": "A dedicated MongoDB Search deployment providing isolated search compute for an Atlas database deployment."
      },
      {
        "id": "mongodb-atlas.concept.stream-processing-workspace",
        "owner": "mongodb-atlas",
        "name": "stream-processing-workspace",
        "description": "An Atlas Stream Processing workspace owning processors and registered source or sink connections."
      },
      {
        "id": "mongodb-atlas.concept.stream-processor",
        "owner": "mongodb-atlas",
        "name": "stream-processor",
        "description": "An Atlas Stream Processing processor continuously executing a declared aggregation pipeline."
      },
      {
        "id": "rf.concept.managed-database",
        "owner": "rf",
        "name": "managed-database",
        "description": "A managed database service or instance, excluding logical tables and databases."
      },
      {
        "id": "rf.concept.object-storage-container",
        "owner": "rf",
        "name": "object-storage-container",
        "description": "An object storage container, excluding multi-service storage accounts."
      }
    ],
    "contexts": [
      {
        "id": "mongodb-atlas.context.ownership",
        "owner": "mongodb-atlas",
        "name": "ownership",
        "description": "Administrative or lifecycle ownership."
      },
      {
        "id": "rf.context.runtime",
        "owner": "rf",
        "name": "runtime",
        "description": "A declared execution environment or target without proof of effective execution."
      }
    ],
