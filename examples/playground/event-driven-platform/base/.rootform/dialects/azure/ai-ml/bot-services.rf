# Maintained directly from pinned provider evidence.
concept "bot-service" {
  kind        = entity
  description = "An Azure Bot Service bot registration or application."
}

rule "azure-bot" {
  match {
    type = "azurerm_bot_service_azure_bot"
  }

  as = concept.bot-service

  context {
    as  = context.core.ownership
    to  = concept.resource-group
    via = source.resource_group_name
  }
}

rule "bot-channels-registration" {
  match {
    type = "azurerm_bot_channels_registration"
  }

  as = concept.bot-service

  context {
    as  = context.core.ownership
    to  = concept.resource-group
    via = source.resource_group_name
  }
}

rule "bot-web-app" {
  match {
    type = "azurerm_bot_web_app"
  }

  as = concept.bot-service

  context {
    as  = context.core.ownership
    to  = concept.resource-group
    via = source.resource_group_name
  }
}

rule "health-bot" {
  match {
    type = "azurerm_healthbot"
  }

  as = concept.bot-service

  context {
    as  = context.core.ownership
    to  = concept.resource-group
    via = source.resource_group_name
  }
}
