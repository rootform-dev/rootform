# Maintained directly from pinned provider evidence.
concept "data-share" {
  kind        = entity
  description = "An Azure Data Share publication."
}

concept "data-share-account" {
  kind        = scope
  description = "An Azure Data Share account."
}

rule "data-share" {
  match {
    type = "azurerm_data_share"
  }

  as = concept.data-share
}

rule "data-share-account" {
  match {
    type = "azurerm_data_share_account"
  }

  as = concept.data-share-account

  context {
    as  = context.core.ownership
    to  = concept.resource-group
    via = source.resource_group_name
  }
}
