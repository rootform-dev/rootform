    "concepts": [
      {
        "id": "aws.concept.iam-role",
        "owner": "aws",
        "name": "iam-role",
        "description": "An AWS IAM role, distinct from an explicitly non-human service principal."
      },
      {
        "id": "google.concept.google-cloud-project",
        "owner": "google",
        "name": "google-cloud-project",
        "description": "A Google Cloud project serving as a resource and billing boundary."
      },
      {
        "id": "newrelic.concept.apm-application",
        "owner": "newrelic",
        "name": "apm-application",
        "description": "An application boundary observed through New Relic APM."
      },
      {
        "id": "newrelic.concept.application-configuration",
        "owner": "newrelic",
        "name": "application-configuration",
        "description": "Application settings or key transactions supporting New Relic application observability."
      },
      {
        "id": "newrelic.concept.aws-connection",
        "owner": "newrelic",
        "name": "aws-connection",
        "description": "An AWS role-backed connection used by New Relic to ingest or query data."
      },
      {
        "id": "newrelic.concept.browser-observability-application",
        "owner": "newrelic",
        "name": "browser-observability-application",
        "description": "An application boundary instrumented for browser or frontend observability."
      },
      {
        "id": "newrelic.concept.cloud-integration-configuration",
        "owner": "newrelic",
        "name": "cloud-integration-configuration",
        "description": "Cloud-service selections supporting a linked New Relic cloud account."
      },
      {
        "id": "newrelic.concept.cloud-observability-integration",
        "owner": "newrelic",
        "name": "cloud-observability-integration",
        "description": "A provider-neutral integration collecting telemetry and resource data from a cloud account, subscription, or project."
      },
      {
        "id": "newrelic.concept.federated-logs-partition",
        "owner": "newrelic",
        "name": "federated-logs-partition",
        "description": "A storage, retention, and forwarding partition supporting a Federated Logs setup."
      },
      {
        "id": "newrelic.concept.federated-logs-setup",
        "owner": "newrelic",
        "name": "federated-logs-setup",
        "description": "A New Relic Federated Logs storage and query boundary backed by external cloud storage."
      },
      {
        "id": "newrelic.concept.fleet",
        "owner": "newrelic",
        "name": "fleet",
        "description": "A homogeneous set of Kubernetes clusters or hosts managed by New Relic Fleet Control."
      },
      {
        "id": "newrelic.concept.fleet-configuration",
        "owner": "newrelic",
        "name": "fleet-configuration",
        "description": "A versioned agent configuration available to New Relic Fleet Control fleets."
      },
      {
        "id": "newrelic.concept.fleet-deployment",
        "owner": "newrelic",
        "name": "fleet-deployment",
        "description": "A controlled agent and configuration rollout supporting a Fleet Control fleet."
      },
      {
        "id": "newrelic.concept.fleet-membership",
        "owner": "newrelic",
        "name": "fleet-membership",
        "description": "An explicit managed-entity assignment supporting a Fleet Control fleet."
      },
      {
        "id": "newrelic.concept.observability-tenant",
        "owner": "newrelic",
        "name": "observability-tenant",
        "description": "A provider-neutral account, organization, or stack boundary isolating observability data and configuration."
      },
      {
        "id": "newrelic.concept.observability-workload",
        "owner": "newrelic",
        "name": "observability-workload",
        "description": "A New Relic operational view grouping related observed entities for health and incident triage."
      },
      {
        "id": "newrelic.concept.synthetic-check",
        "owner": "newrelic",
        "name": "synthetic-check",
        "description": "A synthetic check supporting an observed target without owning target runtime."
      },
      {
        "id": "newrelic.concept.synthetic-execution-location",
        "owner": "newrelic",
        "name": "synthetic-execution-location",
        "description": "A public or private execution location running synthetic checks."
      },
      {
        "id": "newrelic.concept.telemetry-processing-configuration",
        "owner": "newrelic",
        "name": "telemetry-processing-configuration",
        "description": "A parsing, partitioning, pruning, obfuscation, conversion, or Pipeline Control rule."
      },
      {
        "id": "rf.concept.service-identity",
        "owner": "rf",
        "name": "service-identity",
        "description": "A principal explicitly intended for a non-human service or workload, excluding generic roles, permissions, bindings, and credentials."
      }
    ],
