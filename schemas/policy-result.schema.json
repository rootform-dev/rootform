  "$id": "https://rootform.dev/schemas/policy-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One rootform check invocation: the Form it received, the scope it evaluated, one Policy selection shared by every architecture, one entry per evaluated architecture and the overall status. The overall status is violated when any architecture is violated, otherwise failed, indeterminate or no_decision when any architecture has no decision, otherwise passed.",
  "properties": {
    "architectures": {
      "items": {
        "$ref": "#/$defs/Architecture"
      },
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "type": "array"
    },
    "form": {
      "$ref": "#/$defs/FormIdentity"
    },
    "form_format_version": {
      "const": "1"
    },
    "format_version": {
      "const": "1"
    },
    "generator": {
      "$ref": "#/$defs/Generator"
    },
    "scope": {
      "enum": [
        "input",
        "before",
        "after",
        "both"
      ]
    },
    "selection": {
      "$ref": "#/$defs/Selection"
    },
    "status": {
      "enum": [
        "passed",
        "violated",
        "indeterminate",
        "no_decision",
        "failed"
      ]
    }
  },
  "required": [
    "architectures",
    "diagnostics",
    "form_format_version",
    "format_version",
    "generator",
    "selection",
    "status"
  ],
  "title": "Policy result, format 1",
