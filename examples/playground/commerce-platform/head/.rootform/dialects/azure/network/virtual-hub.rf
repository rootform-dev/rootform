# Maintained directly from pinned provider evidence.
concept "route-server" {
  kind        = entity
  description = "An Azure Route Server exchanging routes through BGP."
}

concept "virtual-hub" {
  kind        = scope
  description = "An Azure Virtual WAN regional transit hub."
}

rule "virtual-hub" {
  match {
    type = "azurerm_virtual_hub"
  }

  as = concept.virtual-hub

  context {
    as  = context.core.ownership
    to  = concept.resource-group
    via = source.resource_group_name
  }
}

rule "virtual-hub-routing-intent" {
  match {
    type = "azurerm_virtual_hub_routing_intent"
  }

  as = concept.route-server
}
