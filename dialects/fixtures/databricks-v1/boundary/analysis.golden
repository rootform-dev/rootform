    "concepts": [
      {
        "id": "aws.concept.iam-role",
        "owner": "aws",
        "name": "iam-role",
        "description": "An AWS IAM role, distinct from an explicitly non-human service principal."
      },
      {
        "id": "databricks.concept.external-location",
        "owner": "databricks",
        "name": "external-location",
        "description": "A Unity Catalog external location pairing a cloud storage path with a storage credential."
      },
      {
        "id": "databricks.concept.secret-configuration",
        "owner": "databricks",
        "name": "secret-configuration",
        "description": "A secret identity or access configuration whose value remains outside architecture output."
      },
      {
        "id": "databricks.concept.secret-scope",
        "owner": "databricks",
        "name": "secret-scope",
        "description": "A Databricks secret scope grouping sensitive configuration without exposing secret values."
      },
      {
        "id": "databricks.concept.storage-credential",
        "owner": "databricks",
        "name": "storage-credential",
        "description": "A Unity Catalog credential authorizing access to cloud storage."
      },
      {
        "id": "databricks.concept.unity-catalog-metastore",
        "owner": "databricks",
        "name": "unity-catalog-metastore",
        "description": "A regional Unity Catalog metastore governing Databricks data and AI assets."
      },
      {
        "id": "databricks.concept.workspace-network-configuration",
        "owner": "databricks",
        "name": "workspace-network-configuration",
        "description": "A Databricks registration of customer-managed workspace network infrastructure."
      },
      {
        "id": "rf.concept.object-storage-container",
        "owner": "rf",
        "name": "object-storage-container",
        "description": "An object storage container, excluding multi-service storage accounts."
      },
      {
        "id": "rf.concept.service-identity",
        "owner": "rf",
        "name": "service-identity",
        "description": "A principal explicitly intended for a non-human service or workload, excluding generic roles, permissions, bindings, and credentials."
      },
      {
        "id": "rf.concept.virtual-network",
        "owner": "rf",
        "name": "virtual-network",
        "description": "An explicitly declared virtual network."
      }
