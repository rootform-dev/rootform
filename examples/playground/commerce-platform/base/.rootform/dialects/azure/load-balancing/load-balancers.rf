rule "load-balancer" {
  match {
    kind = "resource"
    type = "azurerm_lb"
  }

  as = concept.core.load-balancer

  context {
    as  = context.core.ownership
    to  = concept.resource-group
    via = source.resource_group_name

    match {
      by       = target.name
      strategy = "exact"
    }
  }
}

rule "application-gateway" {
  match {
    kind = "resource"
    type = "azurerm_application_gateway"
  }

  as = concept.core.load-balancer

  context {
    as  = context.core.ownership
    to  = concept.resource-group
    via = source.resource_group_name

    match {
      by       = target.name
      strategy = "exact"
    }
  }
}

rule "load-balancer-backend-pool" {
  match {
    kind = "resource"
    type = "azurerm_lb_backend_address_pool"
  }

  as = concept.load-balancer-component

  contribution {
    to  = concept.core.load-balancer
    via = source.loadbalancer_id
  }
}

rule "load-balancer-rule" {
  match {
    kind = "resource"
    type = "azurerm_lb_rule"
  }

  as = concept.load-balancer-component

  contribution {
    to  = concept.core.load-balancer
    via = source.loadbalancer_id
  }
}
