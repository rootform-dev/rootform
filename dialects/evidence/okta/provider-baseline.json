  "limitations": [
    "provider configuration cannot prove an Okta org, application, provider, or authentication relation",
    "users, groups, profiles, mappings, assignments, credentials, certificates, hook headers, and opaque settings are never inspected",
    "a helper that references two architecture owners cannot create a direct relation between those owners with current Rootform Language",
    "literal identifiers, names, URLs, JSON, expressions, and depends_on never create semantic facts"
  ]
