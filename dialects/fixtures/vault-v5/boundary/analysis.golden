      {
        "id": "aws.concept.iam-role",
        "owner": "aws",
        "name": "iam-role",
        "description": "An AWS IAM role, distinct from an explicitly non-human service principal."
      },
      {
        "id": "rf.concept.object-storage-container",
        "owner": "rf",
        "name": "object-storage-container",
        "description": "An object storage container, excluding multi-service storage accounts."
      },
      {
        "id": "vault.concept.namespace",
        "owner": "vault",
        "name": "namespace",
        "description": "An isolated Vault tenancy boundary for secrets, auth methods, identities, and policies."
      },
      {
        "id": "vault.concept.secret-definition",
        "owner": "vault",
        "name": "secret-definition",
        "description": "A managed Vault secret definition whose values remain outside architecture output."
      },
      {
        "id": "vault.concept.secret-read",
        "owner": "vault",
        "name": "secret-read",
        "description": "A read-only lookup of Vault secret material whose values remain outside architecture output."
      },
      {
        "id": "vault.concept.secrets-engine",
        "owner": "vault",
        "name": "secrets-engine",
        "description": "A mounted Vault secrets engine storing, generating, or transforming sensitive data."
      }
