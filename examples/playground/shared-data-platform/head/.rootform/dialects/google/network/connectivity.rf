concept "private-service-connect-service-attachment" {
  kind        = entity
  description = "A Private Service Connect service attachment published by a producer."
}

rule "vpc-network-peering" {
  match {
    type = "google_compute_network_peering"
  }

  as = concept.core.network-peering

  context {
    as  = context.core.network
    to  = concept.core.virtual-network
    via = source.network
  }

  context {
    as  = context.core.network
    to  = concept.core.virtual-network
    via = source.peer_network
  }
}

rule "cloud-nat" {
  match {
    type = "google_compute_router_nat"
  }

  as = concept.core.managed-nat

  context {
    as  = context.core.ownership
    to  = concept.cloud-router
    via = source.router
  }
}

rule "ha-vpn-gateway" {
  match {
    type = "google_compute_ha_vpn_gateway"
  }

  as = concept.core.vpn-gateway

  context {
    as  = context.core.network
    to  = concept.core.virtual-network
    via = source.network
  }
}

rule "classic-vpn-gateway" {
  match {
    type = "google_compute_vpn_gateway"
  }

  as = concept.core.vpn-gateway

  context {
    as  = context.core.network
    to  = concept.core.virtual-network
    via = source.network
  }
}

rule "cloud-vpn-tunnel" {
  match {
    type = "google_compute_vpn_tunnel"
  }

  as = concept.core.vpn-connection
}

rule "private-service-connect-endpoint" {
  match {
    type  = "google_compute_forwarding_rule"
    where = source.load_balancing_scheme == ""
  }

  as = concept.core.private-endpoint

  context {
    as  = context.core.network
    to  = concept.core.virtual-network
    via = source.network
  }

  context {
    as  = context.core.network
    to  = concept.core.subnet
    via = source.subnetwork
  }
}

rule "private-service-connect-service-attachment" {
  match {
    type = "google_compute_service_attachment"
  }

  as = concept.private-service-connect-service-attachment
}
