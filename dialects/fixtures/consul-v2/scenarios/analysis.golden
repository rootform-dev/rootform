    "concepts": [
      {
        "id": "consul.concept.access-control-configuration",
        "owner": "consul",
        "name": "access-control-configuration",
        "description": "A binding or attachment supporting a Consul identity boundary."
      },
      {
        "id": "consul.concept.acl-auth-method",
        "owner": "consul",
        "name": "acl-auth-method",
        "description": "A Consul authentication boundary that verifies an external workload identity."
      },
      {
        "id": "consul.concept.admin-partition",
        "owner": "consul",
        "name": "admin-partition",
        "description": "A Consul Enterprise administrative and communication boundary."
      },
      {
        "id": "consul.concept.api-gateway",
        "owner": "consul",
        "name": "api-gateway",
        "description": "A managed gateway that exposes and governs APIs."
      },
      {
        "id": "consul.concept.cluster-peering",
        "owner": "consul",
        "name": "cluster-peering",
        "description": "A Consul cluster peering connection for exported service discovery and mesh traffic."
      },
      {
        "id": "consul.concept.consul-node",
        "owner": "consul",
        "name": "consul-node",
        "description": "A node registered in the Consul service catalog."
      },
      {
        "id": "consul.concept.consul-service",
        "owner": "consul",
        "name": "consul-service",
        "description": "A service registered or selected in the Consul catalog."
      },
      {
        "id": "consul.concept.discovery-chain-configuration",
        "owner": "consul",
        "name": "discovery-chain-configuration",
        "description": "A resolver, router, splitter, or prepared-query detail for service discovery."
      },
      {
        "id": "consul.concept.gateway-configuration",
        "owner": "consul",
        "name": "gateway-configuration",
        "description": "A route or certificate configuration supporting a Consul API gateway."
      },
      {
        "id": "consul.concept.ingress-gateway",
        "owner": "consul",
        "name": "ingress-gateway",
        "description": "A deprecated Consul gateway admitting traffic into the service mesh."
      },
      {
        "id": "consul.concept.jwt-provider",
        "owner": "consul",
        "name": "jwt-provider",
        "description": "A JWT validation boundary used by Consul service mesh intentions."
      },
      {
        "id": "consul.concept.mesh-security-configuration",
        "owner": "consul",
        "name": "mesh-security-configuration",
        "description": "An authorization detail protecting service mesh traffic without proving traffic flow."
      },
      {
        "id": "consul.concept.namespace",
        "owner": "consul",
        "name": "namespace",
        "description": "A Consul Enterprise tenant boundary within an admin partition."
      },
      {
        "id": "consul.concept.operations-configuration",
        "owner": "consul",
        "name": "operations-configuration",
        "description": "An operational or health setting that owns no independent topology."
      },
      {
        "id": "consul.concept.sameness-group",
        "owner": "consul",
        "name": "sameness-group",
        "description": "A Consul group of partitions or peers with equivalent service instances."
      },
      {
        "id": "consul.concept.service-export",
        "owner": "consul",
        "name": "service-export",
        "description": "A service export detail for peers, partitions, or sameness groups."
      },
      {
        "id": "consul.concept.service-mesh",
        "owner": "consul",
        "name": "service-mesh",
        "description": "A Consul service mesh traffic-control and identity boundary."
      },
      {
        "id": "consul.concept.service-networking-configuration",
        "owner": "consul",
        "name": "service-networking-configuration",
        "description": "A mesh-wide or service-specific proxy configuration."
      },
      {
        "id": "consul.concept.terminating-gateway",
        "owner": "consul",
        "name": "terminating-gateway",
        "description": "A Consul gateway connecting mesh services to services outside the mesh."
      },
      {
        "id": "rf.concept.virtual-network",
        "owner": "rf",
        "name": "virtual-network",
        "description": "An explicitly declared virtual network."
      }
    ],
    "contexts": [
